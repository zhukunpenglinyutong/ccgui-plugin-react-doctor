{
  "id": "react-doctor",
  "name": "React Doctor",
  "version": "0.3.1",
  "sdkVersion": "^0.3",
  "minAppVersion": "1.0.0",
  "author": "ccgui",
  "repo": "zhukunpenglinyutong/ccgui-plugin-react-doctor",
  "icon": "docs/icon.png",
  "screenshots": ["docs/screenshot-1.png", "docs/screenshot-2.png"],
  "description": "一键运行 npx react-doctor@latest 代码体检：评分环、错误/警告统计、按文件分组的问题列表与修复建议、原始输出，结果本地持久化；非满分时可「一键修复」把问题清单填入聊天输入框。",
  "tier": "js",
  "permissions": ["ui:panel-tab", "storage", "composer:draft", "exec:npx", "exec:node"]
}
